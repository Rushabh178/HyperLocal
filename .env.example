# Copy to .env (git-ignored) and fill in. application.properties imports ./.env automatically,
# and real environment variables override it.

# PostgreSQL + PostGIS
DB_URL=jdbc:postgresql://localhost:5432/hyper_local
DB_USERNAME=postgres
DB_PASSWORD=change-me

# HS256 signing key for access tokens: Base64 of at least 32 random bytes.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# No profile is active by default. Local development needs "dev" (fake payments that honour
# X-Fake-Payment, logged pushes); without it startup fails unless a real payment gateway and push
# sender are configured (e.g. prod,razorpay,fcm). Uncomment for local development only; never in a
# deployed environment.
#spring.profiles.active=dev
