# Copy to deploy/.env on the server (git-ignored) and fill in.

# Database password. Generate one with:  openssl rand -hex 24
DB_PASSWORD=

# HS256 signing key for access tokens. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Address the apps use to reach this server, e.g. http://13.234.10.20 (Elastic IP)
# or http://hyperlocal-test.duckdns.org. Used for KYC file links.
PUBLIC_BASE_URL=

# Test server: "dev" = fake payments (X-Fake-Payment), pushes and OTPs printed to the log, demo stores
# seeded (password Demo@1234). Read OTPs with:  docker compose logs -f app | grep "DEV OTP"
# Switch to e.g. prod,razorpay,fcm (and set their variables) before real users touch this server.
SPRING_PROFILES_ACTIVE=dev

PAYMENT_WEBHOOK_SECRET=

# Optional first ops admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
